# Camera
vendor.camera.aux.packagelist=org.codeaurora.snapcam,com.android.camera,org.lineageos.aperture,org.lineageos.aperture.dev

# Dalvik
dalvik.vm.dex2oat64.enabled=true

# Filesystem
fs_mgr.overlayfs.prefer_cache_backing_storage=true

# Keystore
ro.security.keystore.keytype=sakv2,gak

# RIL
ro.vendor.qti.va_aosp.support=1

# Netflix
ro.netflix.bsp_rev=Q7250-19133-1

#Infinity Flags
ro.product.marketname=Samsung Galaxy M23 5G
ro.infinity.soc=Snapdragon 750G
ro.infinity.battery=5000 mAh
ro.infinity.display=1080 x 2408, 120 Hz
ro.infinity.camera=50MP+8MP+2MP
